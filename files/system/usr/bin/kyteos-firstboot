#!/usr/bin/env bash
MARKER="$HOME/.config/.kyteos-firstboot-done"
[ -f "$MARKER" ] && exit 0
mkdir -p "$HOME/.config"
WALL="$(find /usr/share/ublue-os/kyteos/wallpapers -maxdepth 1 -type f ! -name '.*' -print -quit 2>/dev/null || true)"
if [ -n "$WALL" ]; then
  plasma-apply-wallpaperimage "$WALL" 2>/dev/null || true
fi
touch "$MARKER"
